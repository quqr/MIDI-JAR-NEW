{
  "version": "1.0.0",
  "description": "GM Standard MIDI Instrument List — sample sources crawled from danigb/smplr (player) and smpldsnds (sample host)",
  "sources": {
    "smplr": {
      "version": "1.0.0",
      "url": "https://github.com/danigb/smplr",
      "factories": [
        {
          "id": "soundfont",
          "name": "Soundfont",
          "description": "General MIDI soundfonts (MusyngKite / FluidR3_GM kits)",
          "helper": "getSoundfontNames()"
        },
        {
          "id": "soundfont2",
          "name": "Soundfont2",
          "description": "Direct .sf2 file player — user-provided .sf2 URL (parsed via soundfont2)",
          "helper": null
        },
        {
          "id": "sampler",
          "name": "Sampler",
          "description": "Custom buffer / SFZ preset sampler — user-provided buffers or SmplrPreset",
          "helper": null
        },
        {
          "id": "splendid-grand-piano",
          "name": "SplendidGrandPiano",
          "description": "Sampled Steinway grand, 4 velocity layers",
          "helper": null
        },
        {
          "id": "electric-piano",
          "name": "ElectricPiano",
          "description": "CP80, PianetT, Wurlitzer, TX81Z (+ jRhodes3d)",
          "helper": "getElectricPianoNames()"
        },
        {
          "id": "drum-machine",
          "name": "DrumMachine",
          "description": "Classic drum machines (TR-808, TR-909, etc.)",
          "helper": "getDrumMachineNames()"
        },
        {
          "id": "drum-abuse",
          "name": "DrumAbuse",
          "description": "~210 machines across 5 packs (Synthabuse collection)",
          "helper": "getDrumAbuseMachineNames()"
        },
        {
          "id": "mallet",
          "name": "Mallet",
          "description": "VCSL mallets (marimba, vibraphone, xylophone, glockenspiel, etc.)",
          "helper": "getMalletNames()"
        },
        {
          "id": "mellotron",
          "name": "Mellotron",
          "description": "Mellotron archive samples",
          "helper": "getMellotronNames()"
        },
        {
          "id": "smolken",
          "name": "Smolken",
          "description": "Smolken double bass (Arco / Pizzicato / Switched)",
          "helper": "getSmolkenNames()"
        },
        {
          "id": "versilian",
          "name": "Versilian",
          "description": "VCSL multi-instrument (partial support, async load)",
          "helper": "getVersilianInstruments()"
        }
      ]
    },
    "smpldsnds": {
      "version": "1.0.0",
      "url": "https://github.com/smpldsnds",
      "description": "Open-source / public-domain sample repositories that host the raw audio loaded by smplr (served via GitHub Pages). Each repo ships files.json / instruments.json; drum-abuse-* repos additionally ship pack.json / index.json / instruments/<slug>.json / machines/<id>.json.",
      "sampleRepos": [
        {
          "id": "archiveorg-mellotron",
          "name": "archiveorg-mellotron",
          "description": "Mellotron archive samples (CD-ROM NKI/WAV).",
          "license": "Unknown",
          "url": "https://github.com/smpldsnds/archiveorg-mellotron",
          "backs": ["mellotron"]
        },
        {
          "id": "drum-abuse-vol1",
          "name": "drum-abuse-vol1",
          "description": "Drum Abuse Vol.1 — Vintage Rhythm Machines (≤1977): organ rhythms & electromechanical boxes.",
          "license": "Per machine, see source",
          "url": "https://github.com/smpldsnds/drum-abuse-vol1",
          "backs": ["drum-abuse"]
        },
        {
          "id": "drum-abuse-vol2",
          "name": "drum-abuse-vol2",
          "description": "Drum Abuse Vol.2 — The 808 Era (1978–1981): birth of electronic rhythm, pure analog synthesis.",
          "license": "Per machine, see source",
          "url": "https://github.com/smpldsnds/drum-abuse-vol2",
          "backs": ["drum-abuse"]
        },
        {
          "id": "drum-abuse-vol3",
          "name": "drum-abuse-vol3",
          "description": "Drum Abuse Vol.3 — LinnDrum & 909 Birth (1982–1983): hip-hop and house foundations.",
          "license": "Per machine, see source",
          "url": "https://github.com/smpldsnds/drum-abuse-vol3",
          "backs": ["drum-abuse"]
        },
        {
          "id": "drum-abuse-vol4",
          "name": "drum-abuse-vol4",
          "description": "Drum Abuse Vol.4 — Digital Drums Boom (1984–1985): sampling goes mainstream (SP-12, RX-11, DDD-1).",
          "license": "Per machine, see source",
          "url": "https://github.com/smpldsnds/drum-abuse-vol4",
          "backs": ["drum-abuse"]
        },
        {
          "id": "drum-abuse-vol5",
          "name": "drum-abuse-vol5",
          "description": "Drum Abuse Vol.5 — MIDI Goes Consumer (1986): affordable MIDI rhythm boxes (TR-505, RX-21, Casio MT).",
          "license": "Per machine, see source",
          "url": "https://github.com/smpldsnds/drum-abuse-vol5",
          "backs": ["drum-abuse"]
        },
        {
          "id": "drum-machines",
          "name": "drum-machines",
          "description": "A collection of public domain samples of different drum machines.",
          "license": "Public domain",
          "url": "https://github.com/smpldsnds/drum-machines",
          "backs": ["drum-machine"]
        },
        {
          "id": "freepats-old-piano-fb",
          "name": "freepats-old-piano-fb",
          "description": "Historic piano with an honky-tonk tone (FreePats).",
          "license": "CC0 1.0",
          "url": "https://github.com/smpldsnds/freepats-old-piano-fb",
          "backs": []
        },
        {
          "id": "hydrogen-drum-samples",
          "name": "hydrogen-drum-samples",
          "description": "Drum samples from the Hydrogen drum machine project.",
          "license": "GPLv2+",
          "url": "https://github.com/smpldsnds/hydrogen-drum-samples",
          "backs": ["drum-machine"]
        },
        {
          "id": "sfzinstruments-dsmolken-double-bass",
          "name": "sfzinstruments-dsmolken-double-bass",
          "description": "1958 Otto Rubner double bass played and mapped by D. Smolken.",
          "license": "Royalty-free (all commercial & non-commercial use)",
          "url": "https://github.com/smpldsnds/sfzinstruments-dsmolken-double-bass",
          "backs": ["smolken"]
        },
        {
          "id": "sfzinstruments-greg-sullivan-e-pianos",
          "name": "sfzinstruments-greg-sullivan-e-pianos",
          "description": "Greg Sullivan's electric pianos (CP80, PianetT, Wurlitzer, TX81Z).",
          "license": "CC 3.0 Unported",
          "url": "https://github.com/smpldsnds/sfzinstruments-greg-sullivan-e-pianos",
          "backs": ["electric-piano"]
        },
        {
          "id": "sfzinstruments-jlearman-jrhodes3d",
          "name": "sfzinstruments-jlearman-jrhodes3d",
          "description": "J. Learman Rhodes: 1977 Rhodes Mark I Stage 73 electric piano.",
          "license": "CC0 1.0",
          "url": "https://github.com/smpldsnds/sfzinstruments-jlearman-jrhodes3d",
          "backs": ["electric-piano"]
        },
        {
          "id": "sfzinstruments-splendid-grand-piano",
          "name": "sfzinstruments-splendid-grand-piano",
          "description": "AKAI Steinway samples with 4 velocity layers.",
          "license": "Public Domain",
          "url": "https://github.com/smpldsnds/sfzinstruments-splendid-grand-piano",
          "backs": ["splendid-grand-piano"]
        },
        {
          "id": "sfzinstruments-tictokmen-retrodrums1",
          "name": "sfzinstruments-tictokmen-retrodrums1",
          "description": "Retro drum samples from Sonic Pi (TicTokMen RetroDrums).",
          "license": "CC0 1.0",
          "url": "https://github.com/smpldsnds/sfzinstruments-tictokmen-retrodrums1",
          "backs": ["drum-machine"]
        },
        {
          "id": "sgossner-vcsl",
          "name": "sgossner-vcsl",
          "description": "The Versilian Community Sample Library (VCSL): multi-instrument sample set.",
          "license": "CC0 1.0",
          "url": "https://github.com/smpldsnds/sgossner-vcsl",
          "backs": ["mallet", "versilian"]
        },
        {
          "id": "sonic-pi-samples",
          "name": "sonic-pi-samples",
          "description": "Sample collection bundled with Sonic Pi software.",
          "license": "CC0 1.0",
          "url": "https://github.com/smpldsnds/sonic-pi-samples",
          "backs": []
        },
        {
          "id": "soundfonts",
          "name": "soundfonts",
          "description": "A curated collection of free and creative-commons soundfonts in sf/sf2 format.",
          "license": "Mixed, per file",
          "url": "https://github.com/smpldsnds/soundfonts",
          "backs": ["soundfont", "soundfont2"]
        },
        {
          "id": "supersaw",
          "name": "supersaw",
          "description": "A collection of 60 supersaw sounds.",
          "license": "GNU GPL v3",
          "url": "https://github.com/smpldsnds/supersaw",
          "backs": []
        },
        {
          "id": "wavedit-online",
          "name": "wavedit-online",
          "description": "A growing library of free wavetable banks shared by WaveEdit.",
          "license": "CC0 1.0 Universal",
          "url": "https://github.com/smpldsnds/wavedit-online",
          "backs": []
        }
      ]
    }
  },
