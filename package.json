{
  "name": "midi-jar",
  "version": "2.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:pre",
    "build:pre": "npm run format:fix && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:win": "tauri build --target nsis",
    "tauri:build:mac": "tauri build --target dmg",
    "lint": "eslint --ext .js,.ts,.vue -f ./node_modules/eslint-friendly-formatter src",
    "lint:fix": "eslint --ext .js,.ts,.vue -f ./node_modules/eslint-friendly-formatter --fix src",
    "format": "prettier .",
    "format:fix": "prettier . --write",
    "setup-hooks": "bash setup-hooks.sh",
    "type-check": "vue-tsc --noEmit",
    "generate-licenses": "node scripts/generate-licenses.js"
  },
  "keywords": [
    "vue3",
    "vite",
    "typescript",
    "web-app"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tonaljs/chord": "^6.1.2",
    "@tonaljs/chord-type": "^5.1.1",
    "@tonaljs/core": "^5.0.2",
    "@tonaljs/pcset": "^4.10.1",
    "@vitejs/plugin-vue": "6.0.6",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "normalize.css": "8.0.1",
    "pinia": "3.0.4",
    "splitpanes": "^4.0.4",
    "tonal": "^6.4.3",
    "vexflow": "^5.0.0",
    "vue": "3.5.33",
    "vue-i18n": "11.4.0",
    "vue-router": "5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.11.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.10",
    "daisyui": "^5.5.19",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-friendly-formatter": "4.0.1",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-vue": "10.9.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "less": "4.6.4",
    "lint-staged": "16.4.0",
    "prettier": "3.8.3",
    "sass": "1.99.0",
    "sass-loader": "16.0.7",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.0.0",
    "vite-plugin-eslint": "1.8.1",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "^3.2.8"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "npm run lint",
      "git add"
    ],
    "*.vue": [
      "npm run lint",
      "git add"
    ]
  }
}
