{
  "name": "midi-jar",
  "version": "2.0.0",
  "description": "MIDI 键盘工具 — 和弦检测、瀑布流钢琴、MIDI 文件播放",
  "keywords": [
    "typescript",
    "vite",
    "vue3",
    "web-app"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "analyze": "vite-bundle-visualizer",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "build": "npm run build:pre",
    "build:web": "cross-env VITE_WEB=true NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:pre": "npm run format:fix && cross-env NODE_OPTIONS=--max-old-space-size=8192 vue-tsc --noEmit && vite build",
    "dev": "vite",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --target dmg",
    "tauri:build:win": "tauri build --target nsis",
    "tauri:dev": "tauri dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@audio/pitch-mcleod": "^1.0.1",
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tonaljs/chord": "^6.1.2",
    "@tonaljs/chord-type": "^5.1.1",
    "@tonaljs/core": "^5.0.2",
    "@tonaljs/pcset": "^4.10.1",
    "@tonejs/midi": "^2.0.28",
    "@types/three": "^0.185.4",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "animejs": "^4.5.0",
    "colord": "^2.10.0",
    "mediabunny": "^1.55.7",
    "normalize.css": "8.0.1",
    "opensheetmusicdisplay": "^2.1.2",
    "pinia": "4.0.3",
    "pino": "^10.3.1",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.20.1",
    "smplr": "^1.0.0",
    "splitpanes": "^4.1.2",
    "three": "^0.185.1",
    "tonal": "^6.4.3",
    "tone": "^15.1.22",
    "vexflow": "^5.0.0",
    "vue": "3.5.42",
    "vue-i18n": "11.4.10",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/dom-webcodecs": "^0.1.19",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.28",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "17.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "pino-pretty": "^13.1.3",
    "sass": "1.104.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "^8.2.2",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "vue-demi@0.14.10": true,
    "gl@9.0.0-rc.10": true
  }
}
