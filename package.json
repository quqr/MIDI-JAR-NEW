{
  "name": "midi-jar",
  "version": "2.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:pre",
    "build:pre": "npm run format:fix && node --max-old-space-size=8192 ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit && node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:win": "tauri build --target nsis",
    "tauri:build:mac": "tauri build --target dmg",
    "lint": "eslint --ext .js,.ts,.vue -f ./node_modules/eslint-friendly-formatter src",
    "lint:fix": "eslint --ext .js,.ts,.vue -f ./node_modules/eslint-friendly-formatter --fix src",
    "format": "prettier .",
    "format:fix": "prettier . --write",
    "setup-hooks": "bash setup-hooks.sh",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "analyze": "vite-bundle-visualizer",
    "generate-licenses": "node scripts/generate-licenses.js"
  },
  "keywords": [
    "vue3",
    "vite",
    "typescript",
    "web-app"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tonaljs/chord": "^6.1.2",
    "@tonaljs/chord-type": "^5.1.1",
    "@tonaljs/core": "^5.0.2",
    "@tonaljs/pcset": "^4.10.1",
    "@tonejs/midi": "^2.0.28",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "motion-v": "^2.3.0",
    "normalize.css": "8.0.1",
    "pinia": "4.0.2",
    "splitpanes": "^4.1.2",
    "tonal": "^6.4.3",
    "tone": "^15.1.22",
    "vexflow": "^5.0.0",
    "vue": "3.5.39",
    "vue-i18n": "11.4.6",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "daisyui": "^5.6.18",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-friendly-formatter": "4.0.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "10.9.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "less": "4.6.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "sass": "1.101.0",
    "sass-loader": "17.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.1.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-eslint": "1.8.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "npm run lint",
      "git add"
    ],
    "*.vue": [
      "npm run lint",
      "git add"
    ]
  }
}
