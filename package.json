{
  "name": "midi-jar",
  "version": "2.0.0",
  "description": "MIDI 键盘工具 — 和弦检测、瀑布流钢琴、MIDI 文件播放",
  "keywords": [
    "typescript",
    "vite",
    "vue3",
    "web-app"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "analyze": "vite-bundle-visualizer",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "build": "npm run build:pre",
    "build:web": "cross-env VITE_WEB=true NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:pre": "npm run format:fix && cross-env NODE_OPTIONS=--max-old-space-size=8192 vue-tsc --noEmit && vite build",
    "dev": "vite",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --target dmg",
    "tauri:build:win": "tauri build --target nsis",
    "tauri:dev": "tauri dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tonaljs/chord": "^6.1.2",
    "@tonaljs/chord-type": "^5.1.1",
    "@tonaljs/core": "^5.0.2",
    "@tonaljs/pcset": "^4.10.1",
    "@tonejs/midi": "^2.0.28",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "motion-v": "^2.3.0",
    "normalize.css": "8.0.1",
    "pinia": "4.0.2",
    "pino": "^10.3.1",
    "splitpanes": "^4.1.2",
    "tonal": "^6.4.3",
    "tone": "^15.1.22",
    "vexflow": "^5.0.0",
    "vue": "3.5.39",
    "vue-i18n": "11.4.6",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^10.1.0",
    "daisyui": "^5.6.18",
    "jsdom": "^29.1.1",
    "lint-staged": "17.0.8",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "pino-pretty": "^13.1.3",
    "sass": "1.101.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "^8.1.5",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.7",
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "vue-demi@0.14.10": true
  }
}
